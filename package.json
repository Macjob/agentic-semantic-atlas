  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@ipld/dag-cbor": "^9.2.2",
    "js-tiktoken": "^1.0.21",
    "multiformats": "^13.3.1",
    "openai": "^6.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
