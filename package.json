{
  "name": "agentic-semantic-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "ASA/0 minimal prototype: content-addressed semantic concepts with session-local aliases",
  "type": "module",
  "scripts": {
    "asa": "tsx src/cli.ts",
    "demo": "tsx src/demo.ts",
    "benchmark:tokens": "tsx src/benchmark/run.ts",
    "benchmark:fidelity": "tsx src/benchmark/run-model-fidelity.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
